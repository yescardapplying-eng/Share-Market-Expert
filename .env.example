# ==============================================================
# SHARE MARKET EXPERT — ENVIRONMENT CONFIGURATION
# ==============================================================

# --------------------------------------------------------------
# FRONTEND (Next.js Node.js App on Hostinger)
# --------------------------------------------------------------
# In production, set this in Hostinger Web App > Environment Variables
NEXT_PUBLIC_API_URL=https://api.sharemarketexpert.in

# Optional Local Development Port
PORT=3000
NODE_ENV=production

# --------------------------------------------------------------
# BACKEND (PHP REST API on api.sharemarketexpert.in)
# --------------------------------------------------------------
# Set these in your Hostinger cPanel/hPanel PHP environment OR
# inside backend/config/env.php (git-ignored for security)
DB_HOST=localhost
DB_NAME=u123456789_sme
DB_USER=u123456789_smeuser
DB_PASS=YourStrongHostingerDbPassword123#
DB_PORT=3306
